# Sao chép nội dung này vào mục "Secrets" của app trên share.streamlit.io
# (Settings -> Secrets), hoặc lưu thành .streamlit/secrets.toml khi chạy local.
# KHÔNG commit file secrets.toml thật lên GitHub.

PINECONE_API_KEY = "dán-pinecone-api-key-của-bạn"
GROQ_API_KEY = "dán-groq-api-key-của-bạn"

# --- Đăng nhập / phân quyền ---
# Admin: toàn quyền (tải PDF + đặt câu hỏi). Guest: chỉ được đặt câu hỏi.
# Đặt mật khẩu tuỳ ý, càng dài/khó đoán càng tốt.
ADMIN_PASSWORD = "mật-khẩu-admin-của-bạn"
GUEST_PASSWORD = "mật-khẩu-chia-sẻ-cho-người-quen"

# Hạn dùng của GUEST_PASSWORD, định dạng YYYY-MM-DD, tính theo giờ UTC —
# guest được dùng đến HẾT ngày này, sau đó tự động bị vô hiệu hoá.
# Nếu để trống hoặc sai định dạng, tài khoản guest sẽ KHÔNG đăng nhập được
# (bắt buộc phải có hạn dùng).
GUEST_EXPIRES_AT = "2026-12-31"
